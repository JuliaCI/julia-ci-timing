(site_common) {
  # The site and its data files are static; .json.gz files must reach a
  # client as gzip bytes (the analysis scripts decompress them), which the
  # encoder leaves alone since it only compresses text-like types.
  encode zstd gzip
  root * ${site_root}

  redir /db /db/ 308
  handle /db/* {
    reverse_proxy 127.0.0.1:${datasette_port}
  }
  # The site's own reads (db/serve.jl); its responses are already gzipped.
  # One server runs at a time, on either port: a deploy starts the new
  # image's server on the idle port and stops the old one once the new one
  # answers /api/ready, so requests go to the first port that is ready.
  handle /api/* {
    reverse_proxy ${api_upstreams} {
      lb_policy first
      lb_try_duration 5s
      lb_try_interval 250ms
      health_uri /api/ready
      health_interval 5s
      health_timeout 2s
      fail_duration 10s
    }
  }
  # What the ingest renders: the files the site reads, health.json, the
  # database snapshot
  handle_path /data/* {
    root * ${export_root}
    header Cache-Control "no-cache"
    file_server
  }
  handle /healthz {
    rewrite * /health.json
    root * ${export_root}
    header Cache-Control "no-cache"
    file_server
  }
  handle {
    header /assets/* Cache-Control "public, max-age=300"
    try_files {path} {path}/index.html
    file_server
  }
}

http://${public_ip} {
  import site_common
}
%{ if public_hostname != "" ~}

${public_hostname} {
  import site_common
}
%{ endif ~}
