#!/bin/bash
# Deploy an image: record it as the host's image, pull it, refresh the static
# site from it and start one ingest. Invoked through SSM Run Command by
# .github/workflows/deploy.yml with the digest-pinned image reference.
set -euo pipefail
image_ref="${1:?usage: ci-timing-deploy <repository>@sha256:<digest>}"
case "$image_ref" in
  *@sha256:*) ;;
  *) echo "image reference must be digest-pinned" >&2; exit 1 ;;
esac
set -a; . /etc/ci-timing.host.env; set +a
aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "${CI_TIMING_ECR_REPOSITORY%%/*}" >/dev/null
docker pull "$image_ref"
sed -i "s|^CI_TIMING_IMAGE_REF=.*|CI_TIMING_IMAGE_REF=${image_ref}|" /etc/ci-timing.host.env
docker run --rm --user "${CI_TIMING_RUNTIME_UID}:${CI_TIMING_RUNTIME_GID}" \
  --mount type=bind,src="${CI_TIMING_SITE_DIR}",dst=/site "$image_ref" sync-site
echo "site synced from $image_ref"
systemctl restart ci-timing-datasette.service
# The ingest takes minutes and its outcome is on /healthz; the deploy
# returns as soon as the site is synced
systemctl start --no-block ci-timing-ingest.service
docker image prune -f >/dev/null
