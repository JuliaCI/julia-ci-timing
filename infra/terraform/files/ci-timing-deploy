#!/bin/bash
# Deploy an image: record it as the host's image, pull it, refresh the static
# site from it, switch the API to it once the new server is warm and start one
# ingest. Invoked through SSM Run Command by .github/workflows/deploy.yml with
# the digest-pinned image reference.
set -euo pipefail
image_ref="${1:?usage: ci-timing-deploy <repository>@sha256:<digest>}"
case "$image_ref" in
  *@sha256:*) ;;
  *) echo "image reference must be digest-pinned" >&2; exit 1 ;;
esac
set -a; . /etc/ci-timing.host.env; set +a
aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "${CI_TIMING_ECR_REPOSITORY%%/*}" >/dev/null
docker pull "$image_ref"
docker run --rm --user "${CI_TIMING_RUNTIME_UID}:${CI_TIMING_RUNTIME_GID}" \
  --mount type=bind,src="${CI_TIMING_SITE_DIR}",dst=/site "$image_ref" sync-site
echo "site synced from $image_ref"
# Recorded as the host's image only once the site is synced from it, so a
# failed sync leaves the services on the old image
sed -i "s|^CI_TIMING_IMAGE_REF=.*|CI_TIMING_IMAGE_REF=${image_ref}|" /etc/ci-timing.host.env
aws ssm put-parameter --region "$AWS_REGION" --name "$CI_TIMING_IMAGE_PARAMETER" --type String --overwrite --value "$image_ref" >/dev/null \
  || echo "could not record the image in $CI_TIMING_IMAGE_PARAMETER" >&2
systemctl restart ci-timing-datasette.service

# The API: the new image's server starts on a port no server uses, and the
# old one is stopped only once the new one answers /api/ready, which it does
# when its warm-up has rendered what the site loads on landing. Caddy lists
# every port and sends requests to the first one that is ready, so the
# switch costs no request. A server that never gets ready is stopped and
# the old one keeps serving, with the deploy reported as failed.
old=""; new=""
for port in $CI_TIMING_API_PORTS; do
  if systemctl is-active --quiet "ci-timing-api@$port.service"; then
    old="$old $port"
  else
    new="${new:-$port}"
  fi
done
if [ -z "$new" ]; then
  # Every port has a server (a deploy interrupted between start and stop):
  # the last one started is replaced
  new="${old##* }"; old="${old% *}"
fi
# restart rather than start: the unit may be running the old image already
systemctl restart "ci-timing-api@$new.service"
api_ok=0
for i in $(seq 1 120); do
  if curl -fsS -o /dev/null "http://127.0.0.1:$new/api/ready" 2>/dev/null; then api_ok=1; break; fi
  sleep 5
done
if [ "$api_ok" -eq 1 ]; then
  systemctl enable --quiet "ci-timing-api@$new.service"
  for port in $old; do
    systemctl disable --now --quiet "ci-timing-api@$port.service"
  done
  echo "API switched to port $new"
else
  echo "the API on port $new did not get ready in 10 minutes; the old server keeps serving" >&2
  systemctl disable --now --quiet "ci-timing-api@$new.service"
fi

# The ingest takes minutes and its outcome is on /healthz; the deploy
# returns as soon as the site is synced. A start request while a run is
# in progress would merge into it (a oneshot is "activating" for the whole
# run, never "active", so is-active cannot tell), so wait for that run in
# a transient unit and start one with the new image after: for the ingest
# lock it holds, then for the unit to settle (ExecStopPost runs after the
# lock is released).
case "$(systemctl show -p ActiveState --value ci-timing-ingest.service)" in
  activating|deactivating)
    systemd-run --quiet --collect --unit "ci-timing-ingest-after-deploy-$(date +%s)" sh -c '
      flock /var/lock/ci-timing-ingest.lock true
      while case "$(systemctl show -p ActiveState --value ci-timing-ingest.service)" in activating|deactivating) true ;; *) false ;; esac; do sleep 1; done
      systemctl start --no-block ci-timing-ingest.service'
    ;;
  *)
    systemctl start --no-block ci-timing-ingest.service
    ;;
esac
docker image prune -f >/dev/null
[ "$api_ok" -eq 1 ]
