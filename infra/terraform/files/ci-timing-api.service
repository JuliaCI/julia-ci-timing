[Unit]
Description=The site's API over the ci-timing database
After=network-online.target docker.service ci-timing-datasette.service
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/var/lib/ci-timing

[Service]
Type=simple
ExecStart=/usr/local/bin/ci-timing-run-api
ExecStop=/usr/bin/docker stop ci-timing-api
Restart=always
# Fails until the first deploy has pulled the image, and until the
# datasette unit's ExecStartPre has restored the database on a fresh host
RestartSec=30

[Install]
WantedBy=multi-user.target
