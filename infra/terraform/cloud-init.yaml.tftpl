#cloud-config
write_files:
%{ for path, f in files ~}
  - path: ${path}
    permissions: '${f.mode}'
    encoding: b64
    content: ${base64encode(f.content)}
%{ endfor ~}
runcmd:
  # The AWS CLI v2 and amazon-ssm-agent ship preinstalled in the AL2023 AMI
  - dnf install -y docker tar gzip sqlite e2fsprogs
  - systemctl restart systemd-journald
  # The data volume is attached once the instance runs (aws_volume_attachment),
  # so wait for it; a brand-new one gets a filesystem, an existing one keeps
  # its contents (the database, export, site and clones of the last host)
  - |
    dev="${data_volume_dev}"
    for i in $(seq 1 150); do [ -e "$dev" ] && break; sleep 2; done
    [ -e "$dev" ] || { echo "data volume $dev did not appear" >&2; exit 1; }
    blkid "$dev" >/dev/null 2>&1 || mkfs.ext4 -L ci-timing-data "$dev"
    install -d -m 750 "${data_mount_path}"
    grep -q " ${data_mount_path} " /etc/fstab || echo "$dev ${data_mount_path} ext4 defaults,nofail,x-systemd.device-timeout=300 0 2" >> /etc/fstab
    systemctl daemon-reload
    mount "${data_mount_path}"
  - systemctl enable --now docker amazon-ssm-agent
  - install -d -m 750 -o ${runtime_uid} -g ${runtime_gid} ${data_mount_path} ${data_mount_path}/${export_dir} ${data_mount_path}/${site_dir} ${data_mount_path}/cache
  - install -d -m 755 ${caddy_data_dir} ${caddy_config_dir}
  - systemctl daemon-reload
  - systemctl enable --now ci-timing-caddy ci-timing-datasette ci-timing-api ci-timing-bootstrap ci-timing-ingest.timer ci-timing-archive.timer
